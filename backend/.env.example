# ======== Blockchain & RPC ========
# Contracts are deployed on Ethereum Sepolia (smart-contract/deployments/sepolia.json).
# Use your own Alchemy/Infura URL in production; the public node is rate-limited.
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#
# Local development:
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Block explorer base URL (transaction links are <base>/tx/<hash>)
CHAIN_EXPLORER_BASE_URL=https://sepolia.etherscan.io

# Role signer private keys.
# These are placeholders. Teammates can copy real local keys from `npx.cmd hardhat node`.
# On Sepolia, each key's address must hold its role on the AccessControl contract
# (grant with smart-contract/scripts/grant-role.ts). Current Sepolia role wallets:
#   admin/deployer   0xcd8E5cb88a3338970DfbfA914A98bC4a8dC0eeB6
#   MANUFACTURER     0x98CcB3877a8b75453F4F55f7424400646C2d165F
#   IMPORTER         0x9ffAF316c9E4D85aaE2b591B893C8db5C646F060
#   DISTRIBUTOR      0x6221D37d13f27D4420c956d32135Fdf2BDe43B75
#   CLINIC           0xa9938abDF4C722c70345bE7981Fc3daD23e869E1
#   PHARMACY         0xe969ace694498479Fb627beF81FaDc79ee70f441
#   RECALL_AUTHORITY 0xb682C00dC4B9cA0855645d65A51064FBF7029101
BACKEND_PRIVATE_KEY=<hardhat_account_0_private_key>
ADMIN_PRIVATE_KEY=<hardhat_account_0_private_key>
MANUFACTURER_PRIVATE_KEY=<hardhat_account_0_private_key>
IMPORTER_PRIVATE_KEY=<hardhat_account_1_private_key>
DISTRIBUTOR_PRIVATE_KEY=<hardhat_account_2_private_key>
CLINIC_PRIVATE_KEY=<hardhat_account_3_private_key>
PHARMACY_PRIVATE_KEY=<hardhat_account_4_private_key>
RECALL_AUTHORITY_PRIVATE_KEY=<hardhat_account_0_private_key>

# Smart Contract Addresses
# Sepolia deployment (smart-contract/deployments/sepolia.json):
PRODUCT_REGISTRY_ADDRESS=0x0083D58E800457da6c0A352b8f8280Af29e58330
TRANSFER_LEDGER_ADDRESS=0x247F0C5Ec2cdC88587795A4B947a0E071bD3B90F
ACCESS_CONTROL_ADDRESS=0x834283a80368A17117b5624AF39152919DFb15A9
COLD_CHAIN_REGISTRY_ADDRESS=0x06FaCC6060a93AFfB6DD60DAC7676a9C339394D2
#
# Local: replace with the addresses from deployments/localhost.json after
# npx hardhat run scripts/deploy.ts --network localhost

# ======== Pseudonymization ========
# Shared salt for actor/location hashes (see CryptoUtils.hashWithSalt). Keep
# this secret — anyone with it can recompute actor/location hashes. Per-lot
# salts are separate and generated automatically at lot-commission time.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYSTEM_SALT=<random_64_char_hex_secret>

# ======== IPFS / Pinata ========
# Share this privately, not through git.
PINATA_JWT=<pinata_jwt>

# ======== Firebase ========
# Share these privately, not through git.
FIREBASE_PROJECT_ID=<firebase_project_id>
FIREBASE_DATABASE_URL=<firebase_realtime_database_url>
FIREBASE_PRIVATE_KEY="<firebase_private_key_with_escaped_newlines>"
FIREBASE_CLIENT_EMAIL=<firebase_service_account_email>
FIREBASE_CLIENT_ID=<firebase_client_id>

# ======== Auth & JWT ========
JWT_SECRET=<random_32_byte_hex_or_long_secret>

# ======== Server ========
PORT=5000
NODE_ENV=production
LOG_LEVEL=info
