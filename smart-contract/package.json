{
  "name": "vaccine-traceability-blockchain",
  "version": "1.0.0",
  "description": "MVP blockchain backend for vaccine traceability using Solidity and Hardhat",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:gas": "cross-env REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "gas:benchmark": "hardhat run scripts/gas-benchmark.ts",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "zkp:setup": "node scripts/setup-import-zkp.js",
    "sync-abis": "hardhat run scripts/sync-abis.ts",
    "node:local": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost && npm run sync-abis",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia && npm run sync-abis",
    "routes:local": "hardhat run scripts/configure-routes.ts --network localhost",
    "routes:sepolia": "hardhat run scripts/configure-routes.ts --network sepolia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thienanpham160806-code/vaccine-traceability-blockchain.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/thienanpham160806-code/vaccine-traceability-blockchain/issues"
  },
  "homepage": "https://github.com/thienanpham160806-code/vaccine-traceability-blockchain#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@types/node": "^25.6.2",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "bash": "^0.0.1",
    "circomlib": "^2.0.5",
    "snarkjs": "^0.7.5"
  }
}
