NEXT_PUBLIC_APP_NAME=Vaccine Traceability

# Production:
NEXT_PUBLIC_API_URL=https://vaccine-traceability-backend.up.railway.app
NEXT_PUBLIC_CONSUMER_VERIFY_BASE_URL=https://vaccine-traceability-frontend.vercel.app/consumer/verify

# Local development (uncomment if needed):
# NEXT_PUBLIC_API_URL=http://localhost:5000
# NEXT_PUBLIC_CONSUMER_VERIFY_BASE_URL=http://localhost:3000/consumer/verify

NEXT_PUBLIC_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Chain configuration — set USE_AMOY=false to fall back to Sepolia
NEXT_PUBLIC_USE_AMOY=true
NEXT_PUBLIC_CHAIN_EXPLORER_BASE_URL=https://www.oklink.com/vi/api/v5/explorer/address?chain univariate=80002
NEXT_PUBLIC_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=true

# Used by wallet-signed writes (src/lib/wallet-contracts.ts). Fill these in
# after deploying (see smart-contract/deployments/<network>.json).
NEXT_PUBLIC_PRODUCT_REGISTRY_ADDRESS=
NEXT_PUBLIC_TRANSFER_LEDGER_ADDRESS=

# Frontend runs at:
# http://localhost:3000

# Backend API should run at:
# Local: http://localhost:5000
# Production Render: https://vaccine-traceability-blockchain.onrender.com
