NEXT_PUBLIC_APP_NAME=Vaccine Traceability

# Backend API base URL.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000
# Production: set to the deployed backend, e.g. https://<your-backend>.up.railway.app

# Base URL encoded into consumer QR codes.
NEXT_PUBLIC_CONSUMER_VERIFY_BASE_URL=http://localhost:3000/consumer/verify
# Production: https://vaccine-traceability-blockchain.vercel.app/consumer/verify

NEXT_PUBLIC_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Chain configuration.
# Contracts are deployed on Ethereum Sepolia (see smart-contract/deployments/sepolia.json).
# Leave NEXT_PUBLIC_USE_AMOY unset/false; set it to true only after deploying to Polygon Amoy.
NEXT_PUBLIC_USE_AMOY=false
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Adds the local Hardhat chain (127.0.0.1:8545) next to Sepolia for local development.
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=true
# Transaction links are built as <base>/tx/<hash>.
NEXT_PUBLIC_CHAIN_EXPLORER_BASE_URL=https://sepolia.etherscan.io

# Used by wallet-signed writes (src/lib/wallet-contracts.ts).
# Sepolia deployment (smart-contract/deployments/sepolia.json):
NEXT_PUBLIC_PRODUCT_REGISTRY_ADDRESS=0x0083D58E800457da6c0A352b8f8280Af29e58330
NEXT_PUBLIC_TRANSFER_LEDGER_ADDRESS=0x247F0C5Ec2cdC88587795A4B947a0E071bD3B90F
# For a local Hardhat chain, use the addresses from deployments/localhost.json instead.
